# Copy this file to .env and fill in your values

# Server
PORT = 5000

# MongoDB - Use MongoDB Atlas connection string or local MongoDB
# Atlas example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/fithub
# Local example:  mongodb://localhost:27017/fithub
MONGO_URI = mongodb://localhost:27017/fithub

# JWT Secret - change to a long random string
JWT_SECRET = change_this_to_a_long_random_secret_string
JWT_EXPIRE = 7d

# Email OTP (Gmail)
# 1. Enable 2-Step Verification in Google Account
# 2. Go to Security -> App passwords -> Create
# 3. Use that 16-char password here
EMAIL_USER = your_email@gmail.com
EMAIL_PASS = your_16_char_app_password

# Razorpay Payment Gateway (get from https://dashboard.razorpay.com)
# Leave blank to fall back to "Pay at Gym" mode
RAZORPAY_KEY_ID =
RAZORPAY_KEY_SECRET =

# Frontend URL
CLIENT_URL = http://localhost:3000
